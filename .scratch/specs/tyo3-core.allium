-- allium: 3
-- tyo3-core.allium

-- Scope: TyO3 project lifecycle, configuration, file management, and backend metadata
-- Includes:
--   - TyProject session lifecycle (open, reload, close)
--   - Configuration model and version pinning
--   - File discovery and enumeration
--   - Backend version metadata
-- Excludes:
--   - Type checking (see tyo3-analysis.allium)
--   - Symbol queries (see tyo3-symbols.allium)
--   - Code navigation (see tyo3-navigation.allium)
--   - Semantic tokens and type hierarchy (see tyo3-advanced.allium)

------------------------------------------------------------
-- Configuration
------------------------------------------------------------

config {
    target_ty_version: String = "0.0.40"
    target_ruff_commit: String = "3cb09eba689ebb49e799131092121928cc789c18"
    target_ty_commit: String = "7b95bc219d1dcebc3ce39d222c66c14a3825c9a0"
    default_coordinate_mode: String = "python"
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value Path {
    components: List<String>
}

value TyProjectConfig {
    python_version: String?
    config_path: Path?
    extra_search_paths: Set<Path>
    respect_gitignore: Boolean
    force_exclude: Boolean
    check_all_files: Boolean
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ProjectStatus { closed | open | error }

enum FileCategory { first_party | vendored | stub | dependency }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity TyProject {
    root: Path
    status: ProjectStatus
    coordinate_mode: String
    python_version: String?
    config_path: Path?
    extra_search_paths: Set<Path>
    respect_gitignore: Boolean
    force_exclude: Boolean
    check_all_files: Boolean
    opened_at: Timestamp
    last_reloaded_at: Timestamp?

    -- Relationships
    files: ProjectFile with project = this

    -- Derived
    is_open: status = open
    has_error: status = error
}

entity ProjectFile {
    path: Path
    project: TyProject
    file_category: FileCategory
    last_checked_at: Timestamp?
}

value BackendInfo {
    tyo3_version: String
    ty_version: String
    ty_commit: String
    ruff_submodule_commit: String
    backend_source: String
}

------------------------------------------------------------
-- Black box helpers
------------------------------------------------------------

-- project_files(root, config): discovers all Python files belonging
--   to the project at the given root, using ty's native discovery
-- is_directory(path): returns true if the path is a directory on disk
-- is_first_party(path): returns true if the file is a first-party project file
-- is_vendored(path): returns true if the file is vendored
-- is_stub(path): returns true if the file is a type stub (.pyi)
-- is_dependency(path): returns true if the file is a dependency

------------------------------------------------------------
-- Project Lifecycle
------------------------------------------------------------

rule OpenProject {
    when: UserOpensProject(root, config)

    requires: is_directory(root)
    requires: not exists TyProject{root: root, status: open}

    let default_config = TyProjectConfig(
        python_version: null,
        config_path: null,
        extra_search_paths: {},
        respect_gitignore: true,
        force_exclude: false,
        check_all_files: true
    )
    let effective = config ?? default_config

    ensures: TyProject.created(
        root: root,
        status: open,
        coordinate_mode: config.default_coordinate_mode,
        python_version: effective.python_version,
        config_path: effective.config_path,
        extra_search_paths: effective.extra_search_paths,
        respect_gitignore: effective.respect_gitignore,
        force_exclude: effective.force_exclude,
        check_all_files: effective.check_all_files,
        opened_at: now
    )
    ensures:
        for path in project_files(root, effective):
            let category =
                if is_first_party(path): first_party
                else if is_vendored(path): vendored
                else if is_stub(path): stub
                else: dependency
            ProjectFile.created(
                path: path,
                project: TyProject{root: root, status: open},
                file_category: category
            )
}

rule OpenProjectPathNotFound {
    when: UserOpensProject(root, config)

    requires: not is_directory(root)

    ensures: ProjectOpenError(path: root, reason: path_not_found)
}

rule ReloadProject {
    when: UserReloadsProject(project)

    requires: project.is_open

    ensures: project.last_reloaded_at = now
    ensures: project.status = open
}

rule CloseProject {
    when: UserClosesProject(project)

    requires: project.is_open

    ensures: project.status = closed
}

------------------------------------------------------------
-- File Management
------------------------------------------------------------

rule ListFiles {
    when: UserListsFiles(project)

    requires: project.is_open

    ensures: FileListReturned(
        project: project,
        files: project.files,
        total_count: project.files.count
    )
}

rule FilterFilesByCategory {
    when: UserListsFilesFiltered(project, category)

    requires: project.is_open

    let filtered = project.files where file_category = category

    ensures: FilteredFileListReturned(
        project: project,
        files: filtered,
        category: category,
        count: filtered.count
    )
}

------------------------------------------------------------
-- Backend Metadata
------------------------------------------------------------

rule QueryBackendInfo {
    when: UserQueriesBackendInfo()

    ensures: BackendInfoReturned(
        info: BackendInfo(
            tyo3_version: "0.1.0",
            ty_version: config.target_ty_version,
            ty_commit: config.target_ty_commit,
            ruff_submodule_commit: config.target_ruff_commit,
            backend_source: "astral-sh/ty@" + config.target_ty_version
        )
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ProjectCannotBeReopened {
    for p in TyProject where status = open:
        not exists TyProject{root: p.root, status: open}
}

invariant FilesBelongToOpenProject {
    for f in ProjectFile:
        f.project.status = open
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface TyProjectAPI {
    facing _: User

    provides:
        UserOpensProject(root, config)
        UserReloadsProject(project)
            when project.is_open
        UserClosesProject(project)
            when project.is_open
        UserListsFiles(project)
            when project.is_open
        UserListsFilesFiltered(project, category)
            when project.is_open
        UserQueriesBackendInfo()

    @guarantee SessionOwnership
        -- Each TyProject instance owns one Rust ProjectDatabase.
        -- Repeated calls return from the same database context.

    @guidance
        -- Path resolution: accept absolute and project-relative paths.
        -- Reject paths outside the project tree.
        -- Returned paths are absolute by default.
        -- Project file discovery follows ty's native discovery rules.
}
